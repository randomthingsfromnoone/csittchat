{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "jsx": "react-jsx", "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.config.ts", "vite.test.config.ts", "playwright.config.ts"]
}
